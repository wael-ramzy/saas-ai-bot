# ═══════════════════════════════════════════════════════════════
# SUPABASE — قاعدة البيانات
# ═══════════════════════════════════════════════════════════════
# احصل عليها من: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SECRET_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ═══════════════════════════════════════════════════════════════
# GROQ — محرك الذكاء الاصطناعي (للردود)
# ═══════════════════════════════════════════════════════════════
# احصل عليها من: https://console.groq.com/keys
# نماذج مقترحة: llama-3.3-70b-versatile (أدق) أو mixtral-8x7b-32768 (أسرع)
GROQ_API_KEY=gsk_xxxxxxxxxxxxx
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.4
GROQ_MAX_TOKENS=800

# ═══════════════════════════════════════════════════════════════
# OPENAI — لتوليد الـ Embeddings (نظام RAG)
# ═══════════════════════════════════════════════════════════════
# احصل عليها من: https://platform.openai.com/api-keys
# ملاحظة: نستخدم OpenAI للتوكنات الرخيصة (Embedding) فقط
# Groq يستخدم للردود (Chat) — هذا يوفر 90% من التكلفة
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxx

# ═══════════════════════════════════════════════════════════════
# META WEBHOOK — كلمة التحقق لجميع القنوات
# ═══════════════════════════════════════════════════════════════
# كلمة سرية تختارها بنفسك — توضع في Meta App عند إعداد Webhooks
META_WEBHOOK_VERIFY_TOKEN=your-secret-verify-token-here

# ═══════════════════════════════════════════════════════════════
# TELEGRAM — إشعارات الطلبات للتجار
# ═══════════════════════════════════════════════════════════════
# احصل على التوكن من @BotFather في تليجرام
# chat_id: يُخزَّن لكل تاجر في قاعدة البيانات (جدول clients)
# لا تضع chat_id هنا — النظام يجلبه من Supabase تلقائياً
TELEGRAM_BOT_TOKEN=123456789:AAAAA-bbbbb...

# ═══════════════════════════════════════════════════════════════
# SERVER — إعدادات الخادم
# ═══════════════════════════════════════════════════════════════
PORT=3000
NODE_ENV=production
